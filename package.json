{
  "name": "leafpress",
  "version": "0.1.0",
  "private": true,
  "description": "个人内容工作台：把日常开发变成素材，把一份原稿改成多个平台、多种形态的版本",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "leafpress": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "15.0.0",
    "gray-matter": "4.0.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.10"
  }
}
